{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "private, no-cache" }
      ]
    }
  ]
}
